# Copy to .env to change a default. Nothing here is required: CONTENTdm's web
# services need no key and no account.
#
# The server reads .env from the directory it is started in -- the
# repository root, when launched with `uv --directory /path/to/contentdm-mcp`.
# Variables already set in the environment take precedence.

# Optional: an email address or URL added to the User-Agent, so an
# institution can reach you if your use ever causes it trouble.
# CONTENTDM_CONTACT=you@example.org

# Optional: directory for the on-disk response cache.
# CONTENTDM_CACHE_DIR=~/.cache/contentdm-mcp

# Optional: HTTP timeout in seconds for one request (default 30; image
# downloads get 120 to read).
# CONTENTDM_TIMEOUT=30

# Optional: least seconds between two requests to one site (default 1, never
# below 0.5).
# CONTENTDM_MIN_INTERVAL=1
